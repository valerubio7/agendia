{
  "name": "agendia",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --env-file=\"$HOME/.config/agendia/dev.env\" run scripts/dev-stack.ts",
    "bootstrap:admin": "bun --env-file=\"$HOME/.config/agendia/dev.env\" run scripts/bootstrap-admin.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:scaffolding": "bun test tests/scaffolding.test.ts",
    "test:unit": "bun test tests/unit packages apps tests/contracts/http-events.contract.test.ts",
    "test:integration": "bun test tests/integration",
    "test:contracts": "bun test tests/contracts",
    "test:tenant-isolation": "bun test tests/tenant-isolation tests/integration/tenant-rls.integration.test.ts",
    "test:acceptance": "bun test tests/acceptance",
    "test:harness": "playwright test --project=historical-harness",
    "test:e2e": "playwright test --project=system",
    "test": "bun run test:scaffolding && bun run test:unit && bun run test:integration && bun run test:contracts && bun run test:tenant-isolation && bun run test:acceptance && bun run test:harness && bun run test:e2e",
    "db:generate": "bun run scripts/db-generate.ts",
    "db:migrate": "bun run scripts/db-migrate.ts",
    "db:check": "bun run scripts/db-check.ts",
    "backup:drill": "bun run scripts/restore-drill.ts",
    "security:scan": "bun run scripts/secret-scan.ts",
    "scope:check": "bun run scripts/scope-check.ts",
    "build": "tsc -p tsconfig.json --noEmit && bun run --cwd apps/web build"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testcontainers/postgresql": "12.1.0",
    "@types/bun": "latest",
    "@types/node": "latest",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "testcontainers": "12.1.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@node-rs/argon2": "2.1.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.1",
    "pg-boss": "12.28.0",
    "postgres": "3.4.9",
    "zod": "4.4.3"
  },
  "allowScripts": {
    "file:.bun/postgres@3.4.9/node_modules/postgres": true,
    "file:../../../../node_modules/.bun/@whiskeysockets+baileys@6.7.21+9ed1b5d4353a312b/node_modules/@whiskeysockets/baileys": true,
    "file:../undici@8.10.0/node_modules/undici": true,
    "file:../../cron-parser@5.10.0/node_modules/cron-parser": true,
    "file:../luxon@3.7.2/node_modules/luxon": true,
    "file:../glob@10.5.0/node_modules/glob": true,
    "file:../../tinyexec@1.3.0/node_modules/tinyexec": true,
    "file:../../cookie@2.0.1/node_modules/cookie": true,
    "file:../../axios@1.20.0+4e139b56dad1b80a/node_modules/axios": true,
    "file:../../protobufjs@7.6.5/node_modules/protobufjs": true,
    "file:../../cookie@1.1.1/node_modules/cookie": true,
    "file:../../pino-abstract-transport@3.0.0/node_modules/pino-abstract-transport": true,
    "file:../../foreground-child@3.3.1/node_modules/foreground-child": true,
    "file:../../jackspeak@3.4.3/node_modules/jackspeak": true,
    "file:../../minimatch@9.0.9/node_modules/minimatch": true,
    "file:../../minipass@7.1.3/node_modules/minipass": true,
    "file:../../package-json-from-dist@1.0.1/node_modules/package-json-from-dist": true,
    "file:../../path-scurry@1.11.1/node_modules/path-scurry": true,
    "file:../mkdirp@3.0.1/node_modules/mkdirp": true,
    "file:../../lightningcss@1.33.0/node_modules/lightningcss": true,
    "file:../../../@grpc+grpc-js@1.14.4/node_modules/@grpc/grpc-js": true,
    "file:../../../@grpc+proto-loader@0.7.15/node_modules/@grpc/proto-loader": true,
    "file:../../ssh2@1.17.0/node_modules/ssh2": true,
    "file:../../content-type@2.1.0/node_modules/content-type": true,
    "file:../../media-typer@2.0.0/node_modules/media-typer": true,
    "file:../../pino-abstract-transport@2.0.0/node_modules/pino-abstract-transport": true,
    "file:../../thread-stream@3.2.0/node_modules/thread-stream": true,
    "file:../../hookified@1.15.1/node_modules/hookified": true,
    "file:../../ret@0.5.0/node_modules/ret": true,
    "file:../yargs@17.7.3/node_modules/yargs": true,
    "file:../../signal-exit@4.1.0/node_modules/signal-exit": true,
    "file:../../../@isaacs+cliui@8.0.2/node_modules/@isaacs/cliui": true,
    "file:../../lru-cache@10.4.3/node_modules/lru-cache": true,
    "file:../../../@grpc+proto-loader@0.8.1/node_modules/@grpc/proto-loader": true,
    "file:../../cpu-features@0.0.10/node_modules/cpu-features": true,
    "file:../../cliui@8.0.1/node_modules/cliui": true,
    "file:../../get-caller-file@2.0.5/node_modules/get-caller-file": true,
    "file:../../y18n@5.0.8/node_modules/y18n": true,
    "file:../../yargs-parser@21.1.1/node_modules/yargs-parser": true,
    "file:../../hashery@1.5.1/node_modules/hashery": true
  }
}
