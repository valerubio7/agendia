{
  "name": "agendia",
  "version": "0.8.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "bun test tests/unit packages apps scripts",
    "test:integration": "bun test tests/integration",
    "test:contracts": "bun test tests/contracts",
    "test:e2e": "playwright test",
    "test": "bun run test:unit && bun run test:integration && bun run test:contracts && bun run test:e2e",
    "db:migrate:dev": "bun run scripts/db/db-migrate.ts",
    "build": "tsc -p tsconfig.json --noEmit && bun run --cwd apps/web build"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testcontainers/postgresql": "12.1.0",
    "@types/bun": "latest",
    "@types/node": "latest",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "testcontainers": "12.1.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@node-rs/argon2": "2.1.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.1",
    "libphonenumber-js": "1.13.14",
    "pg-boss": "12.28.0",
    "postgres": "3.4.9",
    "zod": "4.4.3"
  }
}
