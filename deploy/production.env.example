# Copy to deploy/.env.production (ignored); replace every placeholder before use.
APP_ORIGIN=https://agendia.example.com
POSTGRES_PASSWORD=REPLACE_WITH_HEX_MIGRATOR_PASSWORD
API_DB_PASSWORD=REPLACE_WITH_HEX_API_PASSWORD
ADMIN_DB_PASSWORD=REPLACE_WITH_HEX_ADMIN_PASSWORD
WORKER_DB_PASSWORD=REPLACE_WITH_HEX_WORKER_PASSWORD
MANAGER_DB_PASSWORD=REPLACE_WITH_HEX_MANAGER_PASSWORD
WHATSAPP_LINK_CODE_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
BAILEYS_KMS_VERSION=v1
BAILEYS_KMS_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
DEEPSEEK_API_KEY=REPLACE_WITH_PROVIDER_KEY
AGENDIA_ADMIN_EMAIL=admin@example.com
AGENDIA_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD_AT_LEAST_16_CHARACTERS
