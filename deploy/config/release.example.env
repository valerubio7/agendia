# Copy outside the repository and replace every placeholder with environment-specific values.
AGENDIA_PROCESS=__PROCESS_NAME__
AGENDIA_ENVIRONMENT=__ENVIRONMENT__
AGENDIA_ENVIRONMENT_ID=__ENVIRONMENT_UUID__
AGENDIA_SECRET_SET_ID=__SECRET_SET_UUID__
AGENDIA_RELEASE_DIGEST=__SHA256_DIGEST__
APP_ORIGIN=__HTTPS_ORIGIN__
# Copy one file per process; set only that process's *_FILE values, never DATABASE_URL or inline credentials.
AGENDIA_ISOLATION_MANIFEST_FILE=/run/secrets/isolation-manifest.invalid
AGENDIA_RELEASE_MANIFEST_FILE=/run/secrets/release-manifest.invalid
AGENDIA_MIGRATION_EVIDENCE_FILE=/run/secrets/migration-evidence.invalid
CLUSTER_ADMIN_DATABASE_URL_FILE=/run/secrets/cluster-admin-database-url.invalid
API_DATABASE_URL_FILE=/run/secrets/api-database-url.invalid
WHATSAPP_MANAGER_DATABASE_URL_FILE=/run/secrets/whatsapp-manager-database-url.invalid
MESSAGE_WORKER_DATABASE_URL_FILE=/run/secrets/message-worker-database-url.invalid
WEB_DATABASE_URL_FILE=/run/secrets/web-database-url.invalid
MIGRATE_DATABASE_URL_FILE=/run/secrets/migrate-database-url.invalid
QUEUE_INIT_DATABASE_URL_FILE=/run/secrets/queue-init-database-url.invalid
BOOTSTRAP_ADMIN_DATABASE_URL_FILE=/run/secrets/bootstrap-admin-database-url.invalid
VERIFY_CONFIG_DATABASE_URL_FILE=/run/secrets/verify-config-database-url.invalid
