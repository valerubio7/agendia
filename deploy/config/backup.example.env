# Safe, non-usable placeholders only. Do not place repository credentials or an age private identity here.
# Accepted credential-free locator form: sftp:user@host:/absolute/path (no password or private identity).
RESTIC_REPOSITORY=sftp:backup@backup.example.invalid:/agendia-production
RESTIC_PASSWORD_FILE=/etc/agendia/backup/restic-password
AGENDIA_BACKUP_DATABASE_URL_FILE=/etc/agendia/backup/database-url
AGENDIA_BACKUP_AGE_RECIPIENT=age1qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq
AGENDIA_BACKUP_OFF_HOST_CONFIRMED=false
# repository.env, restic password, and backup DB files are root:root 0400.
# Keep provider credentials only in installed root-only repository.env, never in this repository or evidence.
# The age private identity remains offline with the recovery custodian and is never mounted in this unit.
