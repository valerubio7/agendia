{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": [
      "bun",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@agendia/domain/client-registry": ["packages/domain/src/clients.ts"],
      "@agendia/domain/calendar-values": ["packages/domain/src/business-calendar/values.ts"],
      "@agendia/domain/appointment-lifecycle": ["packages/domain/src/appointments/lifecycle.ts"],
      "@agendia/domain/business-calendar": ["packages/domain/src/business-calendar/calendar.ts"],
      "@agendia/domain/agenda-availability": ["packages/domain/src/appointments/availability.ts"],
      "@agendia/domain/resource-catalog": ["packages/domain/src/resources.ts"],
      "@agendia/*": [
        "packages/*/src/index.ts"
      ]
    },
    "jsx": "react-jsx",
    "noEmit": true
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts"
  ]
}
