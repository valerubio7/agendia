{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": [
      "bun",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@agendia/*": [
        "packages/*/src/index.ts"
      ]
    },
    "jsx": "react-jsx"
  }
}
